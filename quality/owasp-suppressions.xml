<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- Test-scope only: never reaches a deployed image -->
    <suppress>
        <notes>Testcontainers and its transitive Docker client are test scope only</notes>
        <gav regex="true">^org\.testcontainers:.*$</gav>
        <cvssBelow>10</cvssBelow>
    </suppress>

</suppressions>
